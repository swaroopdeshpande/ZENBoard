<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='styles/main_new.css') }}">
</head>
<body>
    <div class="app-container">
        <!-- Header with Welcome Message -->
        <header class="header">
            <div class="welcome-section">
                <p class="welcome-label">Welcome to</p>
                <h1 class="welcome-title">{{ welcome_name | default("Swaroop's TRMNL") }}</h1>
            </div>
            <button class="settings-btn" onclick="openSettings()">⚙️</button>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Playlist Selector -->
            <div class="playlist-selector">
                <label for="playlistSelect">Active Playlist:</label>
                <select id="playlistSelect" onchange="switchPlaylist()">
                    {% for playlist in playlists %}
                    <option value="{{ playlist.id }}" {% if playlist.id == current_playlist %}selected{% endif %}>
                        {{ playlist.name }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Plugins Grid -->
            <section class="plugins-section">
                <h2 class="section-title">Active Plugins</h2>
                <div class="plugins-grid">
                    {% if playlist_plugins %}
                        {% for plugin in playlist_plugins %}
                        <div class="plugin-card" onclick="openPluginSettings('{{ plugin.id }}')">
                            <div class="plugin-icon">
                                {% if plugin.icon %}
                                    <img src="{{ url_for('static', filename='plugin_icons/' + plugin.id + '.png') }}" alt="{{ plugin.display_name }}">
                                {% else %}
                                    <span class="icon-placeholder">📱</span>
                                {% endif %}
                            </div>
                            <h3 class="plugin-name">{{ plugin.display_name }}</h3>
                            <p class="plugin-status">{{ plugin.status | default('Active') }}</p>
                            <button class="plugin-refresh-btn" onclick="refreshPlugin(event, '{{ plugin.id }}')">↻</button>
                        </div>
                        {% endfor %}
                    {% else %}
                    <div class="empty-state">
                        <p>No plugins in this playlist</p>
                        <button onclick="openSettings()">Add Plugins</button>
                    </div>
                    {% endif %}
                </div>
            </section>

            <!-- Display Preview -->
            <section class="display-section">
                <h2 class="section-title">Current Display</h2>
                <div class="display-preview">
                    <img id="displayImage" src="{{ url_for('static', filename='images/current_image.png') }}?t={{ current_time }}" alt="Current Display">
                </div>
                <button class="refresh-btn" onclick="refreshDisplay()">Refresh Display</button>
            </section>
        </main>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeSettings()">&times;</span>
            <h2>Settings</h2>

            <!-- Welcome Message Settings -->
            <div class="settings-section">
                <h3>Welcome Message</h3>
                <label for="welcomeInput">Custom Welcome Name:</label>
                <input type="text" id="welcomeInput" placeholder="Swaroop's TRMNL" value="{{ welcome_name | default('') }}">
                <button onclick="saveWelcomeName()">Save</button>
            </div>

            <!-- WiFi Settings -->
            <div class="settings-section">
                <h3>WiFi</h3>
                <div class="wifi-selector">
                    <label for="wifiNetworks">Available Networks:</label>
                    <select id="wifiNetworks" onchange="selectWifiNetwork()">
                        <option value="">Scanning...</option>
                    </select>
                    <button class="scan-btn" onclick="scanWifiNetworks()">Scan Networks</button>
                </div>

                <div class="wifi-password">
                    <label for="wifiPassword">WiFi Password:</label>
                    <input type="password" id="wifiPassword" placeholder="Enter password">
                    <button onclick="connectWifi()">Connect</button>
                </div>

                <div id="wifiStatus" class="wifi-status"></div>
            </div>

            <!-- Theme Selector -->
            <div class="settings-section">
                <h3>Theme</h3>
                <div class="theme-grid">
                    <button class="theme-btn" onclick="setTheme('light')" data-theme="light">Light</button>
                    <button class="theme-btn" onclick="setTheme('dark')" data-theme="dark">Dark</button>
                    <button class="theme-btn" onclick="setTheme('ocean')" data-theme="ocean">Ocean</button>
                    <button class="theme-btn" onclick="setTheme('forest')" data-theme="forest">Forest</button>
                    <button class="theme-btn" onclick="setTheme('sunset')" data-theme="sunset">Sunset</button>
                    <button class="theme-btn" onclick="setTheme('nord')" data-theme="nord">Nord</button>
                </div>
            </div>

            <!-- About -->
            <div class="settings-section">
                <h3>About</h3>
                <p>InkyPi Dashboard v2.0</p>
                <p id="systemInfo"></p>
            </div>
        </div>
    </div>

    <script src="{{ url_for('static', filename='scripts/dashboard.js') }}"></script>
</body>
</html>
