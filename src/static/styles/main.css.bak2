EOFcat >> ~/InkyPi/src/static/styles/main.css << 'EOF'

/* ── Plugin page full restyle ── */
.frame {
    padding: 20px 24px !important;
}

.back-button {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 8px 16px !important;
    border-radius: 20px !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    margin-bottom: 20px !important;
    background: var(--button-bg) !important;
    border: 1px solid var(--border-color) !important;
    color: var(--text-primary) !important;
    cursor: pointer !important;
    text-decoration: none !important;
}

.back-button:hover {
    background: var(--accent-primary) !important;
    color: white !important;
    border-color: var(--accent-primary) !important;
}

.app-header {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    padding: 24px 0 20px !important;
    margin-bottom: 0 !important;
    gap: 0 !important;
}

.app-header .app-icon {
    width: 72px !important;
    height: 72px !important;
    min-width: 72px !important;
    max-width: 72px !important;
    min-height: 72px !important;
    max-height: 72px !important;
    border-radius: 18px !important;
    object-fit: contain !important;
    margin-bottom: 12px !important;
    border: 1px solid var(--border-color) !important;
    padding: 8px !important;
    background: var(--bg-secondary) !important;
}

.app-header .header-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    width: 100% !important;
    gap: 8px !important;
}

.app-header .title-container {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
}

.app-title {
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    color: var(--text-primary) !important;
}

.api-key-label {
    font-size: 11px !important;
    padding: 4px 10px !important;
    border-radius: 20px !important;
}

.header-button {
    padding: 8px 18px !important;
    border-radius: 20px !important;
    font-size: 13px !important;
    font-weight: 600 !important;
}

/* Form fields */
.settings-container {
    padding: 16px 0 !important;
}

.form-group {
    margin: 10px 0 !important;
    gap: 8px !important;
}

.form-group label {
    font-size: 14px !important;
    font-weight: 600 !important;
    min-width: 100px !important;
}

.form-input {
    padding: 9px 12px !important;
    border-radius: 10px !important;
    border: 1px solid var(--border-subtle) !important;
    background: var(--input-bg) !important;
    color: var(--text-primary) !important;
    font-size: 14px !important;
}

.form-input:focus {
    outline: none !important;
    border-color: var(--accent-primary) !important;
    box-shadow: 0 0 0 3px rgba(0,113,227,0.15) !important;
}

/* Action buttons at bottom */
.buttons-container {
    display: flex !important;
    gap: 10px !important;
    margin-top: 20px !important;
    padding-top: 16px !important;
    border-top: 1px solid var(--border-light) !important;
}

.action-button {
    flex: 1 !important;
    padding: 12px !important;
    border-radius: 12px !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    border: none !important;
    cursor: pointer !important;
    background: var(--accent-primary) !important;
    color: white !important;
    transition: all 0.2s !important;
}

.action-button:hover {
    opacity: 0.88 !important;
    transform: scale(1.01) !important;
}

.action-button.warn {
    background: var(--accent-warn) !important;
}

/* ── Restore plugin page buttons ── */
.settings-form {
    display: flex !important;
    flex-direction: column !important;
    flex-grow: 1 !important;
    height: auto !important;
    min-height: 200px !important;
}

.buttons-container {
    display: flex !important;
    gap: 10px !important;
    margin-top: 24px !important;
    padding-top: 16px !important;
    border-top: 1px solid var(--border-light) !important;
    position: relative !important;
    bottom: auto !important;
}

/* ── Theme specificity fix - override :root with html + body ── */
html[data-theme="ocean"] body, html[data-theme="ocean"] {
    --bg-primary: #e8f4f8 !important;
    --bg-secondary: #d4e9f2 !important;
    --text-primary: #0d3d66 !important;
    --text-secondary: #1565c0 !important;
    --accent-primary: #0288d1 !important;
    --accent-hover: #01579b !important;
    --border-color: #81d4fa !important;
    --border-light: #b3e5fc !important;
    --border-subtle: #90caf9 !important;
    --button-bg: #d4e9f2 !important;
    --button-hover: #b3e5fc !important;
    --input-bg: #e8f4f8 !important;
    --image-filter: none !important;
}

html[data-theme="forest"] body, html[data-theme="forest"] {
    --bg-primary: #eef6ef !important;
    --bg-secondary: #d9ecda !important;
    --text-primary: #1b4d1e !important;
    --text-secondary: #2e6b32 !important;
    --accent-primary: #43a047 !important;
    --accent-hover: #2e7d32 !important;
    --border-color: #a5d6a7 !important;
    --border-light: #c8e6c9 !important;
    --border-subtle: #b0dbb3 !important;
    --button-bg: #d9ecda !important;
    --button-hover: #c8e6c9 !important;
    --input-bg: #eef6ef !important;
    --image-filter: none !important;
}

html[data-theme="sunset"] body, html[data-theme="sunset"] {
    --bg-primary: #fff7ed !important;
    --bg-secondary: #ffe8cc !important;
    --text-primary: #7a3e00 !important;
    --text-secondary: #b85c00 !important;
    --accent-primary: #ff6f00 !important;
    --accent-hover: #e65100 !important;
    --border-color: #ffcc80 !important;
    --border-light: #ffe0b2 !important;
    --border-subtle: #ffd699 !important;
    --button-bg: #ffe8cc !important;
    --button-hover: #ffdcb0 !important;
    --input-bg: #fff7ed !important;
    --image-filter: none !important;
}

html[data-theme="nord"] body, html[data-theme="nord"] {
    --bg-primary: #2e3440 !important;
    --bg-secondary: #3b4252 !important;
    --text-primary: #eceff4 !important;
    --text-secondary: #d8dee9 !important;
    --accent-primary: #88c0d0 !important;
    --accent-hover: #8fbcbb !important;
    --border-color: #4c566a !important;
    --border-light: #434c5e !important;
    --border-subtle: #4c566a !important;
    --button-bg: #3b4252 !important;
    --button-hover: #434c5e !important;
    --input-bg: #2e3440 !important;
    --image-filter: brightness(1.1) !important;
}

html[data-theme="nord"] .plugins-container .plugin-item .icon-image,
html[data-theme="dark"] .plugins-container .plugin-item .icon-image {
    filter: invert(0.85) brightness(1.2) !important;
}

/* ── Force body background and text to use theme variables ── */
body {
    background-color: var(--bg-primary) !important;
    color: var(--text-primary) !important;
}

.frame {
    background-color: var(--bg-secondary) !important;
    border-color: var(--border-color) !important;
}

/* ── Plugin page buttons - restore properly ── */
.buttons-container {
    display: flex !important;
    flex-direction: row !important;
    gap: 10px !important;
    margin-top: 20px !important;
    padding-top: 16px !important;
    border-top: 1px solid var(--border-light) !important;
}

.action-button {
    flex: 1 !important;
    padding: 13px !important;
    border-radius: 12px !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    border: none !important;
    cursor: pointer !important;
    background-color: var(--accent-primary) !important;
    color: white !important;
    display: block !important;
    text-align: center !important;
}

.action-button:hover {
    background-color: var(--accent-hover) !important;
}

.action-button.warn {
    background-color: #e74c3c !important;
}
