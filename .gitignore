# Python
__pycache__/
*.pyc
*.pyo
.env

# Secrets - NEVER commit these
src/config/device.json
gmail_token.json
*.json.bak

# InkyPi runtime
src/static/images/current_image.png
src/config/logging.conf

# OS
.DS_Store
Thumbs.db

# Logs
*.log
.env
src/config/device.json

# Plugin caches (may contain OAuth tokens or personal data)
**/.cache/
spotify_token.json
spotify_push_state.json
amazon_orders_cache.json

# Ereader pagination cache (regenerable)
books/.cache_*.json

# Pushed personal data - Apple Health payload (steps/sleep/resting HR).
# Repo is public; this must never be committed.
src/config/apple_health.json

# Runtime state, not source - regenerated on the device, and it leaks
# usage patterns (what was read, when the frame refreshed, LED settings).
src/config/led_config.json
src/config/refresh_stats.json
books/.ereader_state.json
**/.state/

# Editor/patch backups
*.bak
*.bak_*

# macOS AppleDouble resource forks, created when copying from a Mac
._*

# Panchayat portraits and logo are derived from copyrighted TVF/Amazon material.
# Personal use on the device only - never published. The TBBT portraits predate
# this rule and remain tracked.
src/plugins/tv_quotes/render/portraits/abhishek.png
src/plugins/tv_quotes/render/portraits/pradhan.png
src/plugins/tv_quotes/render/portraits/manju.png
src/plugins/tv_quotes/render/portraits/vikas.png
src/plugins/tv_quotes/render/portraits/prahlad.png
src/plugins/tv_quotes/render/portraits/rinki.png
src/plugins/tv_quotes/render/portraits/bhushan.png
src/plugins/tv_quotes/render/logos/panchayat_logo.png
