[Unit]
Description=ZenBoard mmWave sensor (presence + distance + LED proximity)
After=network.target mosquitto.service zenboard_led.service
Wants=mosquitto.service zenboard_led.service

[Service]
Type=simple
ExecStart=/usr/local/inkypi/venv_inkypi/bin/python3 /usr/local/bin/zenboard_sensor.py
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
