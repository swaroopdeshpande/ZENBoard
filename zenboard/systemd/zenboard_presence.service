[Unit]
Description=ZenBoard Presence Monitor (mmWave)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
ExecStart=/usr/local/inkypi/venv_inkypi/bin/python3 /usr/local/bin/zenboard_presence.py
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
